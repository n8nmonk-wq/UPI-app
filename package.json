{
  "name": "youpi-pg",
  "version": "1.0.0",
  "type": "module",
  "description": "Self-Hosted White-Label UPI Payment Gateway with Payment Observation Engine",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/android-observer-app",
    "apps/checkout-portal",
    "apps/coin-wallet-store",
    "apps/control-center",
    "apps/gmail-observer",
    "apps/merchant-admin",
    "apps/payment-api",
    "apps/payment-help",
    "apps/sms-observer"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "node scripts/clean.js",
    "db:setup": "node scripts/init-db.cjs",
    "store:configure": "node scripts/configure-store.js",
    "observer:pair": "node scripts/observer-pairing.js",
    "observer:tunnel": "node scripts/observer-tunnel.js",
    "sync:package": "node scripts/sync-package.cjs",
    "start": "node scripts/start.js",
    "start:prod": "node scripts/start.js",
    "start:prod:api": "node apps/payment-api/src/index.js",
    "dev": "node scripts/dev.js",
    "test": "node scripts/test-all.js",
    "test:all": "node scripts/test-all.js",
    "test:acceptance": "node --test scripts/production-infrastructure.test.js",
    "build:android:apk": "node scripts/build-android-apk.js",
    "sync:android-allowlist": "node scripts/sync-android-allowlist.js",
    "typecheck": "tsc -b --noEmit",
    "store:install": "npm install --prefix apps/rupee-store --no-audit --no-fund",
    "store:dev": "node apps/rupee-store/dev-server.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.22.1"
  },
  "author": "Antigravity Systems",
  "license": "Commercial",
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "protobufjs@8.8.1": true,
    "protobufjs@7.6.6": true
  }
}
